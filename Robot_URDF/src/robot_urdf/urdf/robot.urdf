<?xml version="1.0"?>

<robot name="robot">


    <!-- ========================= -->
    <!--          车身             -->
    <!-- ========================= -->    
    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.4 0.3 0.1"/>
            </geometry>
        </visual>
    </link>

    <!-- ========================= -->
    <!--          雷达             -->
    <!-- ========================= -->
    <link name="lidar_link">
        <visual>
            <geometry>
                <cylinder radius="0.04" length="0.04"/>
            </geometry>
        </visual>
    </link>

    <!-- ========================= -->
    <!--          左轮             -->
    <!-- ========================= -->
    <link name='leftwheel_link'>
        <visual>
            <!--绕 X 轴旋转 90°-->
            <origin xyz="0 0 0"
                rpy="1.5708 0 0"/>

            <geometry>
                <cylinder radius="0.05" length="0.02"/>
            </geometry>
        </visual>
    </link>

    <!-- ========================= -->
    <!--          右轮             -->
    <!-- ========================= -->
    <link name='rightwheel_link'>
        <visual>
            <!--绕 X 轴旋转 90°-->
            <origin xyz="0 0 0"
                rpy="1.5708 0 0"/>

            <geometry>
                <cylinder radius="0.05" length="0.02"/>
            </geometry>
        </visual>
    </link>

    <!-- ========================= -->
    <!--        雷达与车身连接       -->
    <!-- ========================= -->
    <joint name="lidar_joint" type="fixed">
        <parent link="base_link"/>
        <child link="lidar_link"/>
        <origin xyz="0 0 0.07" rpy="0 0 0"/>
    </joint>

    <!-- ========================= -->
    <!--        左轮与车身连接       -->
    <!-- ========================= -->
    <joint name="leftwheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="leftwheel_link"/>
        <origin xyz="0 0.16 -0.05" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <!-- ========================= -->
    <!--        右轮与车身连接       -->
    <!-- ========================= -->
    <joint name="rightwheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="rightwheel_link"/>
        <origin xyz="0 -0.16 -0.05" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

</robot>
